#: audio_plugin.cpp:72
#, kde-format
msgid "An older file named '%1' already exists.\n"
msgstr "'%1' ନାମକ ଗୋଟିଏ ପୁରୁଣା ଫାଇଲ ପୂର୍ବରୁ ଅବସ୍ଥିତ ଅଛି।\n"

#: audio_plugin.cpp:74
#, kde-format
msgid "A similar file named '%1' already exists.\n"
msgstr "'%1' ନାମକ ଗୋଟିଏ ସମାନ ଫାଇଲ ପୂର୍ବରୁ ଅବସ୍ଥିତ ଅଛି।\n"

#: audio_plugin.cpp:76
#, kde-format
msgid "A newer file named '%1' already exists.\n"
msgstr "'%1' ନାମକ ଗୋଟିଏ ନୂତନ ଫାଇଲ ପୂର୍ବରୁ ଅବସ୍ଥିତ ଅଛି।\n"

#: audio_plugin.cpp:78
msgid "Source File"
msgstr "ଉତ୍ସ ଫାଇଲ"

#: audio_plugin.cpp:79
msgid "Existing File"
msgstr "ସ୍ଥିତବାନ ଫାଇଲ"

#: audio_plugin.cpp:80
msgid "Would you like to replace the existing file with the one on the right?"
msgstr "ଡ଼ାହାଣରେ ଥିବା ଫାଇଲ ସହିତ ଆପଣ ଏହି ସ୍ଥିତବାନ ଫାଇକୁ ସ୍ଥାନାନ୍ତରିତ କରିବାକୁ ପସନ୍ଦ କରିବେ କି?"

#: audiopreview.cpp:51
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"ଏହି ଧ୍ୱନୀ ଫାଇଲଟି ସ୍ଥାନୀୟ ଆଧାରରେ \n"
"ସଂରକ୍ଷିତ ହୋଇନାହିଁ।\n"
"ଏହାକୁ ଧାରଣ କରିବା ପାଇଁ ଏହି ନାମପଟିରେ ଦବାନ୍ତୁ।\n"

#: audiopreview.cpp:57
msgid "Unable to load audio file"
msgstr "ଧ୍ୱନୀ ଫାଇଲ ଧାରଣ କରିବାରେ ଅସମର୍ଥ"

#: audiopreview.cpp:88
#, kde-format
msgid "Artist: %1"
msgstr "କଳାକାର: %1"

#: audiopreview.cpp:91
#, kde-format
msgid "Title: %1"
msgstr "ଶୀର୍ଷକ: %1"

#: audiopreview.cpp:94
#, kde-format
msgid "Comment: %1"
msgstr "ଟିପ୍ପଣୀ: %1"

#: audiopreview.cpp:96
#, kde-format
msgctxt "Bitrate: 160 kbits/s"
msgid "Bitrate: %1 %2\n"
msgstr "ବିଟ୍ରେଟ: %1 %2\n"

#: audiopreview.cpp:98
#, kde-format
msgid "Sample rate: %1 %2\n"
msgstr "ନମୁନା ହାର: %1 %2\n"

#: audiopreview.cpp:99
msgid "Length: "
msgstr "ଲମ୍ବ:"
